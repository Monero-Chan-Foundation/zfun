{
  "name": "zdotfun-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo --port 3001",
    "build": "next build",
    "pages:build": "next build && bun x @cloudflare/next-on-pages && find .vercel/output/static -name '*.wasm' -delete",
    "start": "next start --port 3001",
    "lint": "next lint",
    "build:wasm": "cd ../crates/wasm && LIBSQLITE3_FLAGS='SQLITE_OMIT_FLOATING_POINT_HIGHPRECISION -DLONGDOUBLE_TYPE=double' wasm-pack build --target web --out-name zfun_wasm . -- -Z build-std=panic_abort,std",
    "ngrok": "ngrok http 3001",
    "dev:tunnel": "bun run dev & ngrok http 3001"
  },
  "dependencies": {
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@solana/wallet-adapter-backpack": "^0.1.2",
    "@solana/wallet-adapter-base": "^0.9.24",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.36",
    "@solana/wallet-adapter-solflare": "^0.6.29",
    "@solana/web3.js": "^1.98.4",
    "@types/three": "^0.180.0",
    "@zumer/snapdom": "^1.9.14",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "maath": "^0.10.8",
    "modern-screenshot": "^4.6.6",
    "next": "15.5.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.3.0",
    "suspend-react": "^0.1.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "15.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "packageManager": "bun@1.3.1"
}