# Server Configuration
export SERVER_BIND_ADDR=0.0.0.0:3000

# CORS Configuration (comma-separated list of allowed origins)
# Leave empty to allow all origins (permissive mode)
export CORS_ALLOWED_ORIGINS="https://your-domain.com,http://localhost:3000"

# Monerochan Network Configuration
export BASE_RPC_URL=https://rpc.mainnet.monero-chan.org
export MONEROCHAN_NETWORK_PRIVATE_KEY=your_private_key_here

# Optional: TEE Mode (leave empty to disable)
# export TEE_PRIVATE_KEY=your_tee_private_key_here
# export TEE_RPC_URL=https://tee.mainnet.monero-chan.org

# Data and Snapshot Paths
export DATA_DIR=./data
export SNAPSHOT_DIR=./snapshots/snapshot-3140000

# Logging
export RUST_LOG=info
export LOG_DIR=./logs
export LOG_CONSOLE=true

# Database
export PROOF_DB_PATH=proof_requests.db

# Optional: Demo mode (allows duplicate nullifiers for testing)
export DEMO_MODE=true
