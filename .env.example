# Server Configuration
SERVER_BIND_ADDR=127.0.0.1:3000


TEE_PRIVATE_KEY=your_tee_private_key_here
BASE_PRIVATE_KEY=your_base_private_key_here

# Data Storage (Optional - defaults shown)
DATA_DIR=./data
PROOF_DB_PATH=./proof_requests.db

# Logging (Optional - defaults shown)
LOG_DIR=./logs
LOG_CONSOLE=true
RUST_LOG=info,zfun_server=debug

# Automatic Snapshot Updates (Optional - defaults shown)
# Enable automatic snapshot updates when blockchain advances
SNAPSHOT_AUTO_UPDATE=false
# How often to check for updates (seconds)
SNAPSHOT_CHECK_INTERVAL=3600
# Trigger update when N blocks behind
SNAPSHOT_UPDATE_THRESHOLD=1000
# Zebra RPC URL for height checks
ZEBRA_RPC_URL=http://localhost:8232
# Path to update script (relative to repo root)
SNAPSHOT_UPDATE_SCRIPT=./scripts/update_snapshot.sh

# Cloudflare R2 Configuration (for WASM uploads)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=zfun-wasm
